{
  "expo": {
    "name": "Attendify",
    "slug": "attendify",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "attendify",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#6366f1",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendify.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.attendify.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Attendify needs camera access for AI face recognition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attendify needs photo access for face enrollment."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "966ec557-5aa7-4794-976f-d70e73f14758"
      }
    },
    "owner": "anikettiwari02"
  }
}
