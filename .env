# 1. Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon/Public Key (Safe to expose in the app bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# 3. Connection to your local or deployed Python Backend API
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# 4. Supabase Service Role Key (Admin privileges – KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
EXPO_PUBLIC_SUPABASE_SERVICE_KEY=your_service_role_key_here
